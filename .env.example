# All values are server-side secrets. Never prefix with VITE_ and never commit the real ones.

# Free AI: Google AI Studio -> Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional. Pick a model that shows "Free" in AI Studio for your account.
GEMINI_MODEL=gemini-2.5-flash

# Free database: Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "service_role" key (secret!), NOT the anon key
SUPABASE_SERVICE_KEY=

# 24+ random characters, e.g. `openssl rand -hex 32`. Signs login sessions.
SESSION_SECRET=
